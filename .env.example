# Arc Testnet (verified 2026-07-21)
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.network
NEXT_PUBLIC_ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.network
NEXT_PUBLIC_DRAFTPAY_FACTORY_ADDRESS=
NEXT_PUBLIC_DEMO_CONTEST_ADDRESS=
NEXT_PUBLIC_DEMO_EVALUATOR_ADDRESS=
DRAFTPAY_EVIDENCE_PATH=
DRAFTPAY_ARTIFACT_PATH=
AGENT_ARTIFACT_BASE_URL=http://localhost:3000

# Server-only evaluator / Builder Agent wallet. Use a dedicated low-balance Testnet EOA.
AGENT_PRIVATE_KEY=
AGENT_RUN_TOKEN=
AGENT_SUBMIT_CONTEST_ADDRESS=
AGENT_CONTEST_METADATA_PATH=
AGENT_CONTEST_METADATA_JSON=
EVALUATOR_PRIVATE_KEY=
EVALUATOR_CONTEST_ADDRESS=
EVALUATION_INPUT_PATH=apps/agent/fixtures/evaluation-input.example.json
AGENT_MAX_DAILY_SPEND_ATOMIC=5000000

# Circle Gateway Nanopayments
X402_MODE=fixture
X402_SERVICE_URL=http://localhost:3402/x402/brief-analysis
X402_SELLER_ADDRESS=
X402_FACILITATOR_URL=https://gateway-api-testnet.circle.com
X402_MAX_PAYMENT_ATOMIC=50000
X402_MAX_SESSION_SPEND_ATOMIC=100000
X402_MAX_DAILY_SPEND_ATOMIC=500000
X402_ALLOWED_ORIGIN=http://localhost:3402
X402_EMERGENCY_DISABLED=false

# Model provider (server-side only). Without both values the agent uses the labeled fixture
# generator instead of pretending a model ran.
#   kind=chat -> OpenAI-compatible POST /chat/completions (default when the URL contains it)
#   kind=raw  -> a self-hosted endpoint that already returns { html }
MODEL_PROVIDER_URL=
MODEL_PROVIDER_API_KEY=
MODEL_PROVIDER_KIND=chat
MODEL_PROVIDER_MODEL=gpt-4o-mini
